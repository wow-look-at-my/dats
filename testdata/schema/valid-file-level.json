{
  "shared": {
    "files": {
      "config.json": "{\"debug\": true}",
      "sub/dir/nested.txt": "path of the config: {shared.config.json}"
    }
  },
  "workdir": "sub",
  "setup": [
    "cp {shared.config.json} {shared.generated.txt}",
    "echo second setup command"
  ],
  "teardown": "echo single-string teardown",
  "tests": [
    {
      "desc": "uses a shared fixture",
      "cmd": "cat {shared.config.json}",
      "outputs": {
        "stdout": [
          "debug"
        ]
      }
    },
    {
      "desc": "uses a file generated by setup",
      "cmd": "cat {shared.generated.txt}",
      "exit": 0
    },
    {
      "desc": "overrides the file's workdir",
      "cmd": "pwd",
      "workdir": "other"
    }
  ]
}
