{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/wow-look-at-my/dats/schema.json",
  "title": "DATS Test File",
  "description": "Schema for Declarative Automated Testing System (.dats) files",
  "type": "object",
  "required": ["tests"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional reference to this JSON Schema"
    },
    "tests": {
      "type": "array",
      "description": "Array of test cases",
      "items": {
        "$ref": "#/definitions/test"
      }
    }
  },
  "definitions": {
    "test": {
      "type": "object",
      "required": ["cmd"],
      "additionalProperties": false,
      "properties": {
        "desc": {
          "type": "string",
          "description": "Optional description of the test case"
        },
        "cmd": {
          "type": "string",
          "description": "Command to execute. Use {inputs.X} and {outputs.X} placeholders for file paths."
        },
        "exit": {
          "description": "Expected exit code (0-255) or EXIT_* variable name (default 0)",
          "default": 0,
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "string",
              "pattern": "^EXIT_[A-Z_]+$"
            }
          ]
        },
        "timeout": {
          "description": "Optional per-test timeout: an integer number of seconds, or a Go duration string (e.g. \"500ms\", \"2s\", \"1m30s\"). 0 or omitted means no timeout.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "inputs": {
          "$ref": "#/definitions/inputBlock"
        },
        "outputs": {
          "$ref": "#/definitions/outputBlock"
        }
      }
    },
    "inputBlock": {
      "type": "object",
      "description": "Inputs provided to the command",
      "additionalProperties": false,
      "properties": {
        "stdin": {
          "type": "string",
          "description": "Content piped to the command's stdin"
        },
        "files": {
          "type": "object",
          "description": "Fixture files to create before running, mapping filename to content",
          "additionalProperties": {
            "type": "string",
            "description": "File content"
          }
        }
      }
    },
    "outputBlock": {
      "type": "object",
      "description": "Output validation block",
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "$ref": "#/definitions/outputCheck",
          "description": "Patterns to match in stdout"
        },
        "stderr": {
          "$ref": "#/definitions/outputCheck",
          "description": "Patterns to match in stderr"
        },
        "!stdout": {
          "$ref": "#/definitions/outputCheck",
          "description": "Patterns that must NOT appear in stdout"
        },
        "!stderr": {
          "$ref": "#/definitions/outputCheck",
          "description": "Patterns that must NOT appear in stderr"
        },
        "files": {
          "type": "object",
          "description": "Output file validations, mapping filename to checks",
          "additionalProperties": {
            "$ref": "#/definitions/fileCheck"
          }
        },
        "!files": {
          "type": "object",
          "description": "Negated output file validations, mapping filename to checks",
          "additionalProperties": {
            "$ref": "#/definitions/fileCheck"
          }
        }
      }
    },
    "outputCheck": {
      "description": "Output validation - either a list of substring patterns or a map of line-specific regex checks",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of substring patterns to match anywhere in output"
        },
        {
          "type": "object",
          "description": "Map of line numbers (0-indexed) to regex patterns",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "fileCheck": {
      "type": "object",
      "description": "Validation for an output file",
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean",
          "description": "Whether the file should exist"
        },
        "match": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regex patterns that must match the file's contents"
        },
        "notMatch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regex patterns that must NOT match the file's contents"
        }
      }
    }
  }
}
